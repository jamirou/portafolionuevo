---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  robots?: string;
  canonical?: string;
}

const {
  title = 'JMKT | Agencia Digital para PyMEs — Google Maps, Web, Ads e IA en Chile',
  description = 'Agencia digital en Chile especializada en PyMEs. Posicionamos tu negocio en Google Maps, diseñamos páginas web de alta conversión, gestionamos Meta Ads e implementamos Agentes de IA en WhatsApp.',
  keywords = 'agencia digital chile, marketing digital pymes, perfil de negocio google maps, diseño web pymes chile, agente ia whatsapp, publicidad instagram facebook chile, peñaflor, santiago',
  image = 'https://jamirmkt.com/og-image.png',
  robots = 'index, follow',
  canonical,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://jamirmkt.com').toString();
const ogImageURL = image.startsWith('http')
  ? image
  : new URL(image, Astro.site ?? 'https://jamirmkt.com').toString();

