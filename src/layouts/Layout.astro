  '@context': 'https://schema.org',
  '@type': ['MarketingAgency', 'ProfessionalService'],
  name: 'JMKT',
  alternateName: 'JMKT Agencia Digital Chile',
  url: 'https://jamirmkt.com',
  logo: 'https://jamirmkt.com/jmkt-logo.svg',
  image: 'https://jamirmkt.com/og-image.png',
  description,
  telephone: '+56947185397',
  email: 'devjamiro@gmail.com',
  priceRange: '$$',
  founder: {
    '@type': 'Person',
    name: 'Jamiro Manríquez',
    jobTitle: 'Fundador & Estratega Digital',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Peñaflor',
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  areaServed: [
    { '@type': 'Country', name: 'Chile' },
    { '@type': 'AdministrativeArea', name: 'Región Metropolitana' },
    { '@type': 'City', name: 'Peñaflor' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios Digitales para PyMEs JMKT',
    itemListElement: [
      {
        '@type': 'Offer',
        priceCurrency: 'CLP',
        price: '29990',
        itemOffered: {
          '@type': 'Service',
          name: 'Presencia en Google (Google Business Profile & SEO Local)',
          description:
            'Creación o verificación en Google Maps, SEO local, catálogo de servicios, fotos optimizadas y código QR para reseñas.',
        },
      },
      {
        '@type': 'Offer',
        priceCurrency: 'CLP',
        price: '19990',
        itemOffered: {
          '@type': 'Service',
          name: 'Mantención Mensual Google',
          description:
            'Actualizaciones semanales de fotos y ofertas, respuesta profesional a reseñas y reporte mensual de resultados.',
        },
      },
      {
        '@type': 'Offer',
        priceCurrency: 'CLP',
        price: '89990',
        itemOffered: {
          '@type': 'Service',
          name: 'Página Web Express',
          description:
            'Landing page profesional ultrarrápida optimizada para celulares, SEO técnico local y cotización directa por WhatsApp.',
        },
      },
      {
        '@type': 'Offer',
        priceCurrency: 'CLP',
        price: '109990',
        itemOffered: {
          '@type': 'Service',
          name: 'Combo Despegue Total (Google Maps + Página Web Express)',
          description:
            'Presencia completa en Google Maps + Página Web Express con integración de reseñas y mapa.',
        },
      },
      {
        '@type': 'Offer',
        priceCurrency: 'CLP',
        price: '59990',
        itemOffered: {
          '@type': 'Service',
          name: 'Campañas Meta Ads (Instagram & Facebook)',
          description:
            'Publicidad segmentada por radio geográfico de 3 a 5 km enfocada en generar mensajes diarios de clientes en WhatsApp.',
        },
