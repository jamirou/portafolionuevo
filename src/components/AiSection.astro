            </div>
          </div>

          <!-- Explanatory Note Below Chat Window -->
          <div class="mt-4 px-2 flex items-start gap-2.5 text-xs sm:text-[13px] text-slate-400 leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-[#D4FF00] mt-2 shrink-0" aria-hidden="true"></span>
            <p>
              Cada asistente se conecta a un modelo de Inteligencia Artificial real, configurado y entrenado específicamente con tus precios, servicios y forma de atender — sin menús rígidos ni respuestas robóticas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ai-chat-bubble {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 380ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-chat-bubble.is-shown {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-feed-fade {
    transition: opacity 500ms ease;
  }

  .ai-dot {
    animation: aiTypingBounce 1.15s infinite ease-in-out;
  }
  .ai-dot:nth-child(2) {
    animation-delay: 0.18s;
  }
  .ai-dot:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes aiTypingBounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.35;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  .ai-stream-caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    background-color: #D4FF00;
    margin-left: 2px;
    vertical-align: -0.15em;
    animation: aiCaretBlink 0.75s steps(1) infinite;
  }

  @keyframes aiCaretBlink {
    0%, 50% {
      opacity: 1;
    }
    51%, 100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-chat-bubble,
    .ai-dot,
    .ai-stream-caret {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  type Segment = { text: string; className?: string; br?: boolean };

  interface ChatStep {
    sender: 'client' | 'ai';
    time: string;
    attachment?: string;
    preDelay: number;
    typingMs?: number;
    typingLabel?: string;
    headerStatus?: string;
    systemNote?: { text: string; durationMs: number };
    segments: Segment[];
  }

  const conversation: ChatStep[] = [
    {
      sender: 'client',
      time: '22:41 hrs',
      preDelay: 400,
      segments: [
        {
          text: 'Hola buenas noches 👋 Soy Camila Rojas, quiero cotizar el servicio completo y saber si tienen hora mañana a las 11:00 hrs.',
        },
      ],
    },
    {
      sender: 'ai',
      time: '22:41 hrs',
      preDelay: 650,
      typingMs: 1350,
      typingLabel: 'escribiendo',
      headerStatus: 'Analizando consulta · escribiendo...',
      segments: [
        { text: '¡Hola Camila! Claro que sí 😊 Nuestro servicio completo tiene un valor de ' },
        { text: '$29.990', className: 'font-bold text-[#D4FF00]' },
        { text: '. Déjame consultarle en este momento al encargado si el horario de mañana a las ' },
        { text: '11:00 hrs', className: 'font-bold text-white' },
        { text: ' sigue libre; dame un momento para confirmarte.' },
      ],
    },
    {
      sender: 'ai',
      time: '22:42 hrs',
      preDelay: 650,
      systemNote: {
        text: 'Consultando disponibilidad con el encargado...',
        durationMs: 2200,
      },
      typingMs: 1300,
      typingLabel: 'escribiendo',
      headerStatus: 'Confirmación recibida · escribiendo...',
      segments: [
        { text: '¡Buenas noticias Camila! ✅ El encargado me acaba de confirmar que sí tiene disponible mañana a las ' },
        { text: '11:00 hrs', className: 'font-bold text-white' },
        { text: '. Para dejar tu hora agendada solo debes abonar ' },
        { text: '$10.000', className: 'font-bold text-[#D4FF00]' },
        { text: ' a la Cuenta Vista BancoEstado N° ' },
        { text: '12345678', className: 'font-bold text-white' },
        { text: ' (RUT 76.410.290-K) y enviarme el comprobante junto a tu correo. ¿Confirmamos tu reserva?' },
      ],
    },
    {
      sender: 'client',
      time: '22:44 hrs',
      preDelay: 1700,
      attachment: 'Comprobante_Abono_$10.000.jpg',
      segments: [
        {
          text: '¡Súper! Ya hice el abono 🙌 Ahí va el comprobante y mi correo es camila.rojas@gmail.com.',
        },
      ],
    },
    {
      sender: 'ai',
      time: '22:44 hrs',
      preDelay: 700,
      typingMs: 1650,
      typingLabel: 'verificando abono y agendando',
      headerStatus: 'Registrando reserva · escribiendo...',
      segments: [
        { text: '¡Comprobante recibido! 🎉 Tu hora quedó agendada con tus datos:' },
        { text: '', br: true },
        { text: '• ' },
        { text: 'Cliente:', className: 'font-bold text-white' },
        { text: ' Camila Rojas' },
        { text: '', br: true },
        { text: '• ' },
        { text: 'Horario:', className: 'font-bold text-white' },
        { text: ' Mañana · ' },
        { text: '11:00 hrs', className: 'font-bold text-[#D4FF00]' },
        { text: '', br: true },
        { text: '• ' },
        { text: 'Correo:', className: 'font-bold text-white' },
        { text: ' camila.rojas@gmail.com' },
        { text: '', br: true },
        { text: '• ' },
        { text: 'Abono:', className: 'font-bold text-white' },
        { text: ' $10.000 confirmado (saldo $19.990)' },
        { text: '', br: true },
        { text: '¡Te esperamos mañana, Camila! Cualquier cambio me escribes por este mismo chat.' },
      ],
    },
  ];

  const chatPreview = document.getElementById('ai-chat-preview');
  const chatBody = document.getElementById('ai-chat-body');
  const chatFeed = document.getElementById('ai-chat-feed');
  const typingMsg = document.getElementById('ai-msg-typing');
  const typingLabel = document.getElementById('ai-typing-label');
  const statusEl = document.getElementById('ai-chat-status');

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function flattenTokens(segments: Segment[]): Segment[] {
    const out: Segment[] = [];
    segments.forEach((seg) => {
      if (seg.br) {
        out.push({ text: '', br: true });
        return;
      }
      const words = seg.text.split(/(\s+)/);
      words.forEach((w) => {
        if (w.length > 0) out.push({ text: w, className: seg.className });
      });
    });
    return out;
  }

  if (
    !prefersReduced &&
    chatPreview &&
    chatBody &&
    chatFeed &&
    typingMsg &&
    typingLabel &&
    statusEl
  ) {
    let timers: number[] = [];
    let isRunning = false;
    let isVisible = false;

    const clearAllTimers = () => {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
    };

    const schedule = (fn: () => void, ms: number) => {
      const id = window.setTimeout(fn, ms);
      timers.push(id);
      return id;
    };

    const scrollToBottom = (smooth = true) => {
      if (!chatBody) return;
      chatBody.scrollTo({
        top: chatBody.scrollHeight,
        behavior: smooth ? 'smooth' : 'auto',
      });
    };

    const setOnlineStatus = () => {
      statusEl.textContent = 'En línea · Respuesta automática 24/7';
      statusEl.className = 'text-[11px] text-emerald-400 font-medium transition-colors duration-200 truncate';
    };

    const setBusyStatus = (text: string) => {
      statusEl.textContent = text;
      statusEl.className = 'text-[11px] text-[#D4FF00] font-medium transition-colors duration-200 truncate';
    };

    const renderClientBubble = (step: ChatStep) => {
      const row = document.createElement('div');
      row.className = 'flex justify-end ai-chat-bubble';

      const attachmentHtml = step.attachment
        ? `<div class="mb-2 px-2.5 py-1.5 rounded-lg bg-[#0D1321] border border-slate-700 flex items-center gap-2 text-[11px] text-emerald-300 font-medium">
             <span>📄</span>
             <span class="truncate">${step.attachment}</span>
           </div>`
        : '';

      const text = step.segments.map((s) => s.text).join('');

      row.innerHTML = `
        <div class="max-w-[86%] rounded-2xl rounded-tr-sm bg-[#1E293B] border border-slate-700/80 px-4 py-2.5 text-[13px] text-slate-100 shadow-md">
          ${attachmentHtml}
          <p class="leading-relaxed">${text}</p>
          <div class="mt-1 flex items-center justify-end gap-1 text-[10px] text-slate-400">
            <span>${step.time}</span>
            <span class="text-sky-400">✓✓</span>
          </div>
        </div>
      `;

      chatFeed.appendChild(row);
      requestAnimationFrame(() => {
        row.classList.add('is-shown');
        scrollToBottom(true);
      });
    };

    const renderSystemPill = (text: string) => {
      const pillRow = document.createElement('div');
      pillRow.className = 'flex justify-center ai-chat-bubble';
      pillRow.innerHTML = `
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#131B2E] border border-[#D4FF00]/30 text-[11px] font-medium text-slate-300 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#D4FF00] animate-pulse"></span>
          <span>${text}</span>
        </div>
      `;
      chatFeed.appendChild(pillRow);
      requestAnimationFrame(() => {
        pillRow.classList.add('is-shown');
        scrollToBottom(true);
      });
      return pillRow;
    };

    const streamAiBubble = (step: ChatStep, onDone: () => void) => {
      const row = document.createElement('div');
      row.className = 'flex justify-start ai-chat-bubble';

      const card = document.createElement('div');
      card.className =
        'max-w-[92%] rounded-2xl rounded-tl-sm bg-[#131B2E] border border-[#D4FF00]/35 px-4 py-2.5 text-[13px] text-slate-100 shadow-lg';

      const title = document.createElement('div');
      title.className = 'text-[10px] font-bold uppercase tracking-wider text-[#D4FF00] mb-1';
      title.textContent = 'Asistente IA del Negocio';

      const p = document.createElement('p');
      p.className = 'leading-relaxed';

      const caret = document.createElement('span');
      caret.className = 'ai-stream-caret';
      caret.setAttribute('aria-hidden', 'true');
      p.appendChild(caret);

      const meta = document.createElement('div');
      meta.className = 'mt-1 flex items-center justify-end text-[10px] text-slate-400 opacity-0 transition-opacity duration-200';
      meta.innerHTML = `<span>${step.time}</span>`;

      card.appendChild(title);
      card.appendChild(p);
      card.appendChild(meta);
      row.appendChild(card);
      chatFeed.appendChild(row);

      requestAnimationFrame(() => {
        row.classList.add('is-shown');
        scrollToBottom(true);
      });

      const tokens = flattenTokens(step.segments);
      let idx = 0;

      const nextToken = () => {
        if (!isVisible) {
          isRunning = false;
          return;
        }
        if (idx >= tokens.length) {
          caret.remove();
          meta.classList.remove('opacity-0');
          scrollToBottom(true);
          onDone();
          return;
        }

        const tok = tokens[idx];
        idx += 1;

        if (tok.br) {
          p.insertBefore(document.createElement('br'), caret);
        } else if (tok.className) {
          const strong = document.createElement('strong');
          strong.className = tok.className;
          strong.textContent = tok.text;
          p.insertBefore(strong, caret);
        } else {
          p.insertBefore(document.createTextNode(tok.text), caret);
        }

        scrollToBottom(false);

        const trimmed = tok.text.trim();
        let delay = 38;
        if (tok.br) delay = 90;
        else if (trimmed.length === 0) delay = 16;
        else if (/[.?!:]$/.test(trimmed)) delay = 140;
        else if (/[,;]$/.test(trimmed)) delay = 85;

        schedule(nextToken, delay);
      };

      schedule(nextToken, 110);
    };

    const runStep = (stepIndex: number) => {
      if (!isVisible) {
        isRunning = false;
        return;
      }

      if (stepIndex >= conversation.length) {
        setOnlineStatus();
        // Comfortable pause to read the full booked confirmation, then fade & restart
        schedule(() => {
          chatFeed.classList.add('ai-feed-fade', 'opacity-0');
          schedule(() => {
            chatFeed.classList.remove('opacity-0');
            runCycle();
          }, 600);
        }, 6500);
        return;
      }

      const step = conversation[stepIndex];

      schedule(() => {
        if (!isVisible) {
          isRunning = false;
          return;
        }

        if (step.sender === 'client') {
          setOnlineStatus();
          renderClientBubble(step);
          runStep(stepIndex + 1);
          return;
        }

        const startTypingAndStream = () => {
          setBusyStatus(step.headerStatus || 'escribiendo...');
          typingLabel.textContent = step.typingLabel || 'escribiendo';
          typingMsg.classList.remove('hidden');
          scrollToBottom(true);

          schedule(() => {
            typingMsg.classList.add('hidden');
            setOnlineStatus();
            streamAiBubble(step, () => {
              runStep(stepIndex + 1);
            });
          }, step.typingMs || 1200);
        };

        if (step.systemNote) {
          setBusyStatus('Consultando con el encargado...');
          const pill = renderSystemPill(step.systemNote.text);
          schedule(() => {
            pill.innerHTML = `
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-400/30 text-[11px] font-semibold text-emerald-300">
                <span>✓</span>
                <span>Encargado confirmó disponibilidad · 11:00 hrs</span>
              </div>
            `;
            scrollToBottom(true);
            schedule(startTypingAndStream, 450);
          }, step.systemNote.durationMs);
        } else {
          startTypingAndStream();
        }
      }, step.preDelay);
    };

    const runCycle = () => {
      if (!isVisible) {
        isRunning = false;
        return;
      }
      isRunning = true;
      clearAllTimers();
      chatFeed.innerHTML = '';
      typingMsg.classList.add('hidden');
      setOnlineStatus();
      chatBody.scrollTop = 0;
      runStep(0);
    };

    if ('IntersectionObserver' in window) {
      const chatObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isVisible = entry.isIntersecting;
            if (isVisible && !isRunning) {
              runCycle();
            } else if (!isVisible) {
              clearAllTimers();
              isRunning = false;
            }
          });
        },
        { threshold: 0.2 }
      );
      chatObserver.observe(chatPreview);
    } else {
      isVisible = true;
      runCycle();
    }
  }
</script>
