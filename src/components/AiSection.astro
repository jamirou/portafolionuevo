                  <div class="rounded-2xl rounded-tl-sm bg-[#131B2E] border border-[#D4FF00]/30 px-4 py-2.5 shadow-lg inline-flex items-center gap-2.5">
                    <span id="ai-typing-label" class="text-[11px] font-semibold text-slate-300">
                      escribiendo
