---
import JmktLogo from './JmktLogo.astro';

const quickLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#ia', label: 'Agentes IA WhatsApp' },
  { href: '/#planes', label: 'Planes y Precios' },
  { href: '/#arma-tu-plan', label: 'Arma tu plan' },
  { href: '/#certificaciones', label: 'Certificaciones' },
  { href: '/#marcas-ia', label: 'Tendencia IA' },
];
---

<footer class="bg-[#070B14] text-slate-300 border-t border-slate-800/90">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-slate-800/80">
      <!-- Brand Column -->
      <div class="md:col-span-5 space-y-4">
        <a href="/" aria-label="JMKT Agencia Digital">
          <JmktLogo size="md" />
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Agencia digital enfocada en PyMEs de Chile. Posicionamiento en Google Maps, diseño web que convierte, Meta Ads e Inteligencia Artificial en WhatsApp.
        </p>
        <p class="text-xs font-medium text-slate-500">
          Peñaflor, Región Metropolitana · Atención a todo Chile
        </p>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3 space-y-4">
        <h3 class="font-heading font-bold text-xs uppercase tracking-[0.18em] text-white">
          Navegación
        </h3>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-400 hover:text-[#D4FF00] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Direct Contact -->
      <div class="md:col-span-4 space-y-4">
        <h3 class="font-heading font-bold text-xs uppercase tracking-[0.18em] text-white">
          Contacto Directo
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="https://wa.me/56947185397?text=Hola%20JMKT,%20quiero%20impulsar%20la%20presencia%20digital%20de%20mi%20negocio"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 text-slate-300 hover:text-[#D4FF00] transition-colors"
            >
              <span class="w-2 h-2 rounded-full bg-[#D4FF00]"></span>
              <span>+56 9 4718 5397 (WhatsApp y llamadas)</span>
            </a>
          </li>
          <li>
            <a
              href="mailto:devjamiro@gmail.com"
              class="inline-flex items-center gap-2.5 text-slate-300 hover:text-[#D4FF00] transition-colors"
            >
              <span class="w-2 h-2 rounded-full bg-slate-600"></span>
              <span>devjamiro@gmail.com</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© 2026 JMKT · Agencia Digital Chile</p>
      <p>jamirmkt.com · Todos los derechos reservados</p>
    </div>
  </div>
</footer>
