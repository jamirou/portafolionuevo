---
import JmktLogo from './JmktLogo.astro';

const WHATSAPP_URL =
  'https://wa.me/56947185397?text=Hola%20JMKT,%20quiero%20impulsar%20la%20presencia%20digital%20de%20mi%20negocio';

const pillars = [
  {
    label: 'Google & SEO Local',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#D4FF00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    label: 'Diseño Web & Landing Pages',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#D4FF00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 20h8M12 18v2"/></svg>`,
  },
  {
    label: 'Campañas Meta Ads',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#D4FF00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m3 11 18-5v12L3 14v-3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  },
  {
    label: 'Agentes IA & Automatización',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#D4FF00]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3m0 12v3M3 12h3m12 0h3m-3.6-6.4-2.1 2.1m-6.6 6.6-2.1 2.1m0-10.8 2.1 2.1m6.6 6.6 2.1 2.1"/><circle cx="12" cy="12" r="3.5"/></svg>`,
  },
];

const metrics = [
  {
    value: '+310%',
    title: 'Visibilidad Local',
    subtitle: 'Más apariciones en Google Maps',
  },
  {
    value: '24/7',
    title: 'Atención con IA',
    subtitle: 'Respuestas en < 5 seg por WhatsApp',
  },
  {
    value: '3.4x',
    title: 'Más Cotizaciones',
    subtitle: 'Sitios web optimizados para vender',
  },
];
---

<section class="relative bg-[#070B14] text-white overflow-hidden">
  <!-- Ambient Background Lighting & Grid -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-[520px] h-[520px] rounded-full bg-[#D4FF00]/10 blur-[140px]"></div>
    <div class="absolute bottom-0 left-1/4 w-[420px] h-[420px] rounded-full bg-blue-600/10 blur-[130px]"></div>
    <div
      class="absolute inset-0 opacity-[0.04]"
      style="background-image: linear-gradient(to right, #94A3B8 1px, transparent 1px), linear-gradient(to bottom, #94A3B8 1px, transparent 1px); background-size: 56px 56px;"
    ></div>
  </div>

  <!-- Main Hero Grid -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-16 sm:pt-20 sm:pb-24 lg:pt-24 lg:pb-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-6 space-y-7">
        <div class="inline-flex items-center gap-3">
          <span class="w-8 h-[2px] bg-[#D4FF00] rounded-full"></span>
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[#D4FF00]">
            Agencia Digital para PyMEs · Chile
          </span>
        </div>

        <h1 class="font-heading font-extrabold text-4xl sm:text-5xl xl:text-[3.65rem] leading-[1.06] tracking-tight text-white text-balance">
          Haz que tu negocio se vea, se elija y{' '}
          <span class="text-[#D4FF00]">crezca.</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-xl">
          Estrategia digital, posicionamiento en Google, sitios web que convierten y asistentes con Inteligencia Artificial diseñados para que pequeñas y medianas empresas atraigan clientes todos los días.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            href="#arma-tu-plan"
            class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-full bg-[#D4FF00] hover:bg-[#CCFF00] text-[#070B14] font-heading font-bold text-sm sm:text-base transition-all duration-200 shadow-[0_0_28px_rgba(212,255,0,0.28)] hover:shadow-[0_0_36px_rgba(212,255,0,0.45)] hover:-translate-y-0.5"
          >
            <span>Arma tu plan a medida</span>
            <span aria-hidden="true">↓</span>
          </a>

          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-full border border-slate-600 hover:border-white bg-white/[0.03] hover:bg-white/[0.08] text-white font-heading font-semibold text-sm sm:text-base transition-all duration-200"
          >
            <svg class="w-4 h-4 fill-current text-[#D4FF00]" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Hablar por WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Right Column: PyME Performance Dashboard Card -->
      <div class="lg:col-span-6 relative">
        <!-- Giant Geometric Electric-Lime Accent Bars Behind Card -->
        <svg
          viewBox="0 0 260 200"
          fill="none"
          aria-hidden="true"
          class="hidden sm:block absolute -top-10 -left-8 w-64 h-auto opacity-90 pointer-events-none select-none"
        >
          <path d="M90 10H235L210 56H65L90 10Z" fill="#D4FF00" />
          <path d="M58 72H203L178 118H33L58 72Z" fill="#D4FF00" opacity="0.88" />
          <path d="M26 134H171L146 180H1L26 134Z" fill="#D4FF00" opacity="0.72" />
        </svg>

        <!-- Dashboard Card -->
        <div class="relative z-10 rounded-3xl bg-[#131B2E]/95 backdrop-blur-xl border border-slate-800 p-6 sm:p-7 shadow-[0_25px_70px_rgba(0,0,0,0.65)]">
          <!-- Top Bar -->
          <div class="flex items-center justify-between pb-5 border-b border-slate-800/90">
            <div class="flex items-center gap-3">
              <JmktLogo iconOnly size="sm" />
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                  Panel de Impacto PyME
                </p>
                <p class="text-sm font-heading font-bold text-white">
                  Crecimiento Digital Activo
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D4FF00]/10 border border-[#D4FF00]/30 text-[11px] font-semibold text-[#D4FF00]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#D4FF00] animate-pulse"></span>
                En crecimiento
              </span>
            </div>
          </div>

          <!-- Ascending Chart Visual -->
          <div class="mt-5 mb-6 rounded-2xl bg-[#0D1321] border border-slate-800/80 p-4 sm:p-5">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-slate-400">
                Consultas y visibilidad mensual
              </span>
              <span class="text-xs font-bold text-[#D4FF00]">
                ↑ Tendencia sostenida
              </span>
            </div>

            <svg
              viewBox="0 0 420 130"
              class="w-full h-32 sm:h-36 overflow-visible"
              role="img"
              aria-label="Gráfica ascendente de crecimiento en visibilidad y cotizaciones para PyMEs"
            >
              <defs>
                <linearGradient id="jmktChartFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#D4FF00" stop-opacity="0.28" />
                  <stop offset="100%" stop-color="#D4FF00" stop-opacity="0.0" />
                </linearGradient>
                <filter id="limeGlow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3.5" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>

              <!-- Subtle Background Bars -->
              <g fill="#1E293B" opacity="0.7">
                <rect x="14" y="88" width="22" height="34" rx="4" />
                <rect x="64" y="76" width="22" height="46" rx="4" />
                <rect x="114" y="64" width="22" height="58" rx="4" />
                <rect x="164" y="54" width="22" height="68" rx="4" />
                <rect x="214" y="60" width="22" height="62" rx="4" />
                <rect x="264" y="42" width="22" height="80" rx="4" />
                <rect x="314" y="30" width="22" height="92" rx="4" />
                <rect x="364" y="16" width="22" height="106" rx="4" fill="#D4FF00" opacity="0.22" />
              </g>

              <!-- Area Under Curve -->
              <path
                d="M12 106 L75 88 L125 80 L175 62 L225 70 L275 48 L325 38 L392 16 L392 122 L12 122 Z"
                fill="url(#jmktChartFill)"
              />

              <!-- Electric Lime Growth Line -->
              <path
                d="M12 106 L75 88 L125 80 L175 62 L225 70 L275 48 L325 38 L392 16"
                fill="none"
                stroke="#D4FF00"
                stroke-width="3.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                filter="url(#limeGlow)"
              />

              <!-- Glowing End Point -->
              <circle cx="392" cy="16" r="10" fill="#D4FF00" opacity="0.22" />
              <circle cx="392" cy="16" r="5" fill="#D4FF00" />
            </svg>
          </div>

          <!-- 3 PyME Impact Metrics -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            {metrics.map((metric) => (
              <div class="rounded-2xl bg-[#0D1321] border border-slate-800/90 p-4 flex flex-col justify-between hover:border-[#D4FF00]/40 transition-colors">
                <span class="font-heading font-extrabold text-2xl sm:text-[1.6rem] text-[#D4FF00] leading-none">
                  {metric.value}
                </span>
                <div class="mt-2.5">
                  <p class="font-heading font-bold text-xs uppercase tracking-wide text-white">
                    {metric.title}
                  </p>
                  <p class="text-xs text-slate-400 mt-1 leading-snug">
                    {metric.subtitle}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hero Bottom 4 Pillars Bar -->
  <div class="relative z-10 border-t border-slate-800/90 bg-[#0D1321]/85 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 lg:divide-x divide-slate-800/80">
        {pillars.map((pillar) => (
          <div class="flex items-center justify-start lg:justify-center gap-3 py-5 px-2 sm:px-4">
            <span class="shrink-0" set:html={pillar.icon} />
            <span class="text-sm font-medium text-slate-200">{pillar.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
