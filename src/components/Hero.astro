---
import {
  ArrowRight,
  Github,
  Linkedin,
  Mail,
  Instagram,
  Lock,
} from "lucide-react";
---

<section
  class="min-h-[90vh] flex flex-col justify-center items-start pt-20 pb-32 relative overflow-hidden reveal"
>
  <!-- Background Animation (Neo-brutalist floating elements) -->
  <div
    class="absolute inset-0 -z-10 overflow-hidden pointer-events-none opacity-50"
  >
    <!-- Dot Pattern -->
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(circle at 2px 2px, #d4d4d8 1px, transparent 0); background-size: 32px 32px; mask-image: linear-gradient(to bottom, black 50%, transparent 100%);"
    >
    </div>

    <!-- Floating shapes -->
    <div
      class="absolute top-1/4 left-[10%] sm:left-1/4 w-20 h-20 sm:w-32 sm:h-32 bg-amber-300 border-2 border-zinc-900 shadow-[8px_8px_0px_0px_rgba(24,24,27,1)] rounded-full shape-1 opacity-70"
    >
    </div>

    <div
      class="absolute top-1/3 right-[10%] sm:right-1/4 w-16 h-16 sm:w-24 sm:h-24 bg-rose-400 border-2 border-zinc-900 shadow-[8px_8px_0px_0px_rgba(24,24,27,1)] rotate-12 shape-2 opacity-70"
    >
    </div>

    <div
      class="absolute bottom-1/4 right-[20%] sm:right-1/3 w-24 h-8 sm:w-40 sm:h-12 bg-white border-2 border-zinc-900 shadow-[8px_8px_0px_0px_rgba(24,24,27,1)] -rotate-6 shape-3 opacity-70 rounded-full"
    >
    </div>
  </div>

  <div class="space-y-6 max-w-4xl relative z-10">
    <div class="inline-block animate-attention origin-left">
      <a
        href="#servicios"
        class="inline-flex items-center gap-x-2 border-2 border-zinc-900 rounded-full px-4 py-1.5 text-sm font-bold text-zinc-900 bg-white shadow-[4px_4px_0px_0px_rgba(24,24,27,1)] transition-transform hover:-translate-y-0.5 hover:shadow-[2px_2px_0px_0px_rgba(24,24,27,1)] active:translate-y-0 cursor-pointer"
      >
        <span class="relative flex h-3 w-3">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-3 w-3 bg-green-500 border-2 border-zinc-900"
          ></span>
        </span>
        Disponible para nuevos proyectos
      </a>
    </div>

    <h1
      class="text-6xl sm:text-8xl font-black tracking-tighter text-balance text-zinc-900 leading-[0.9]"
    >
      HOLA, SOY <br />
      <span class="text-rose-600">JAMIRO MANRÍQUEZ</span>.
    </h1>

    <p
      class="text-xl sm:text-3xl text-zinc-700 max-w-2xl text-balance font-medium leading-relaxed"
    >
      Ayudo a negocios y PyMEs a aparecer en Google, verse profesionales y atraer más clientes todos los días.
    </p>

    <div class="flex flex-wrap items-center gap-4 pt-8 animate-fade-in-up">
      <a
        href="#servicios"
        class="group flex items-center justify-center gap-2 bg-zinc-900 text-cream-50 px-8 py-4 rounded-full font-bold text-lg hover:bg-zinc-800 transition-all active:scale-95 shadow-[8px_8px_0px_0px_rgba(225,29,72,1)] hover:shadow-[4px_4px_0px_0px_rgba(225,29,72,1)] hover:translate-x-1 hover:translate-y-1 border-2 border-zinc-900"
      >
        Ver Planes PyME ↓
      </a>

      <a
        href="https://wa.me/56947185397?text=Hola%20Jamiro,%20vi%20tu%20web%20y%20quiero%20informaci%C3%B3n%20sobre%20tus%20servicios%20para%20mi%20negocio"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-center gap-2.5 bg-white text-zinc-900 px-8 py-4 rounded-full font-bold text-lg hover:bg-emerald-50 hover:border-zinc-900 transition-all active:scale-95 shadow-[8px_8px_0px_0px_rgba(24,24,27,1)] hover:shadow-[4px_4px_0px_0px_rgba(24,24,27,1)] hover:translate-x-1 hover:translate-y-1 border-2 border-zinc-900"
      >
        <svg class="w-5 h-5 text-emerald-600 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        Hablar por WhatsApp
      </a>

      <div class="flex items-center gap-6 px-4">
        <a
          href="https://github.com/jamirou"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-900 hover:text-rose-600 transition-colors transform hover:scale-110"
          aria-label="GitHub"
        >
          <Github class="w-7 h-7" stroke-width={2.5} />
        </a>
        <a
          href="https://linkedin.com/in/jamiro-manriquez-832aaa204"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-900 hover:text-rose-600 transition-colors transform hover:scale-110"
          aria-label="LinkedIn"
        >
          <Linkedin class="w-7 h-7" stroke-width={2.5} />
        </a>
        <a
          href="https://www.instagram.com/yamir.r.r/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-900 hover:text-rose-600 transition-colors transform hover:scale-110"
          aria-label="Instagram"
        >
          <Instagram class="w-7 h-7" stroke-width={2.5} />
        </a>
        <a
          href="mailto:devjamiro@gmail.com"
          class="text-zinc-900 hover:text-rose-600 transition-colors transform hover:scale-110"
          aria-label="Email"
        >
          <Mail class="w-7 h-7" stroke-width={2.5} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }
  @keyframes float-delayed {
    0% {
      transform: translateY(0) rotate(12deg);
    }
    50% {
      transform: translateY(15px) rotate(0deg);
    }
    100% {
      transform: translateY(0) rotate(12deg);
    }
  }
  @keyframes float-slow {
    0% {
      transform: translateY(0) translateX(0) rotate(-6deg);
    }
    50% {
      transform: translateY(-10px) translateX(10px) rotate(-10deg);
    }
    100% {
      transform: translateY(0) translateX(0) rotate(-6deg);
    }
  }

  /* Animaciones de entrada (primeros 3 segundos) */
  @keyframes pop-in-1 {
    0% {
      transform: translate(-200px, -200px) rotate(-180deg) scale(0.5);
    }
    30% {
      transform: translate(50px, 50px) rotate(45deg) scale(1.2);
    }
    60% {
      transform: translate(-20px, -20px) rotate(-20deg) scale(0.9);
    }
    80% {
      transform: translate(10px, 10px) rotate(10deg) scale(1.05);
    }
    100% {
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
  }

  @keyframes pop-in-2 {
    0% {
      transform: translate(200px, -200px) rotate(180deg) scale(0.5);
    }
    30% {
      transform: translate(-50px, 50px) rotate(-45deg) scale(1.2);
    }
    60% {
      transform: translate(20px, -20px) rotate(20deg) scale(0.9);
    }
    80% {
      transform: translate(-10px, 10px) rotate(-10deg) scale(1.05);
    }
    100% {
      transform: translate(0, 0) rotate(12deg) scale(1);
    }
  }

  @keyframes pop-in-3 {
    0% {
      transform: translate(200px, 200px) rotate(180deg) scale(0.5);
    }
    30% {
      transform: translate(-50px, -50px) rotate(-45deg) scale(1.2);
    }
    60% {
      transform: translate(20px, 20px) rotate(20deg) scale(0.9);
    }
    80% {
      transform: translate(-10px, -10px) rotate(-10deg) scale(1.05);
    }
    100% {
      transform: translate(0, 0) rotate(-6deg) scale(1);
    }
  }

  /* Animación de atención (tintineo) */
  @keyframes attention {
    0%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    2%,
    6% {
      transform: rotate(-3deg) scale(1.05);
    }
    4%,
    8% {
      transform: rotate(3deg) scale(1.05);
    }
    10%,
    98% {
      transform: rotate(0deg) scale(1);
    }
  }

  .shape-1 {
    animation:
      pop-in-1 3s cubic-bezier(0.34, 1.56, 0.64, 1),
      float 6s ease-in-out 3s infinite;
  }
  .shape-2 {
    animation:
      pop-in-2 3s cubic-bezier(0.34, 1.56, 0.64, 1),
      float-delayed 7s ease-in-out 3s infinite alternate;
  }
  .shape-3 {
    animation:
      pop-in-3 3s cubic-bezier(0.34, 1.56, 0.64, 1),
      float-slow 8s ease-in-out 3s infinite;
  }
  .animate-attention {
    animation: attention 7s ease-in-out infinite;
  }
</style>
