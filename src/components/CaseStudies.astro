---
import { getImage } from 'astro:assets';
import ProjectGallery from './ProjectGallery.jsx';

import morales1 from '../assets/proyectos/ProyectoMorales1.png';
import morales2 from '../assets/proyectos/ProyectoMorales2.png';
import morales3 from '../assets/proyectos/ProyectoMorales3.png';
import morales4 from '../assets/proyectos/ProyectoMorales4.png';

import ogaz1 from '../assets/proyectos/proyectoogaz1.png';
import ogaz2 from '../assets/proyectos/proyectoogaz2.png';
import ogaz3 from '../assets/proyectos/proyectoogaz3.png';

import kulfun1 from '../assets/proyectos/kulfun 1.png';
import kulfun2 from '../assets/proyectos/kulfun 2.jpeg';

import iglesia1 from '../assets/proyectos/ProyectoIglesia1.png';
import iglesia2 from '../assets/proyectos/ProyectoIglesia2.png';
import iglesia3 from '../assets/proyectos/ProyectoIglesia3.png';

async function optimizeList(imgs: ImageMetadata[]) {
  return Promise.all(
    imgs.map(async (img) => {
      const opt = await getImage({ src: img, width: 1200, format: 'webp', quality: 88 });
      return opt.src;
    })
  );
}

const [moralesImages, ogazImages, kulfunImages, iglesiaImages] = await Promise.all([
  optimizeList([morales1, morales2, morales3, morales4]),
  optimizeList([ogaz1, ogaz2, ogaz3]),
  optimizeList([kulfun1, kulfun2]),
  optimizeList([iglesia1, iglesia2, iglesia3]),
]);

const cases = [
  {
    category: 'E-commerce B2B · Shopify',
    title: 'Comercializadora Industrial & Eléctrica (Morales EIRL)',
    description:
      'E-commerce B2B en Shopify, estructuración de catálogo técnico y posicionamiento digital orientado a ventas comerciales y cotizaciones directas.',
    impact: 'Catálogo técnico digitalizado y adquisición activa con campañas',
    tags: ['Shopify B2B', 'Catálogo Técnico', 'SEO & Ads'],
    link: 'https://morales-eirl.com/',
    images: moralesImages,
  },
  {
    category: 'Plataforma Corporativa',
    title: 'Transportes Ogaz Ltda.',
    description:
      'Plataforma web corporativa, optimización de velocidad de carga, presentación de flota y canales digitales de contacto para cotización empresarial.',
    impact: 'Imagen corporativa sólida y contacto directo optimizado para móvil',
    tags: ['Web Corporativa', 'Velocidad Web', 'Conversión B2B'],
    link: 'https://transportesogaz.cl/',
    images: ogazImages,
  },
  {
    category: 'Smart Retail & Conversión',
    title: 'Külfün — Smart Retail',
    description:
      'Experiencia web interactiva moderna y arquitectura digital orientada a conversión comercial, resaltando el diferencial innovador de la marca.',
    impact: 'Diferenciación visual de alto impacto enfocada en nuevos clientes',
    tags: ['Smart Retail', 'Experiencia Interactiva', 'UI/UX Conversión'],
    link: 'https://jamirou.github.io/k-lf-n/',
    images: kulfunImages,
  },
  {
    category: 'CMS & Automatización',
    title: 'Plataforma Institucional & Comunidad',
    description:
      'Sistema integral de gestión de contenidos, automatización de comunicaciones y presencia digital unificada para información y actividades.',
    impact: 'Gestión centralizada y comunicación automatizada con la comunidad',
    tags: ['Gestión de Contenidos', 'Automatización', 'Presencia Digital'],
    link: 'https://www.iglesiainternacionalcorderodedios.com/',
    images: iglesiaImages,
  },
];
---

<section id="casos-exito" class="scroll-mt-20 bg-white text-[#0F172A] py-20 sm:py-28 border-t border-slate-200/70">
  <div id="casos-de-exito" class="scroll-mt-20"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 reveal">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="w-8 h-[2px] bg-[#658C00] rounded-full"></span>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#4D6B00]">
            Casos de Éxito y Resultados
          </span>
        </div>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-[#0F172A]">
          Negocios reales impulsados con estrategia digital.
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600">
          Cada proyecto está construido para resolver objetivos comerciales concretos: mayor visibilidad, credibilidad y más oportunidades de venta.
        </p>
      </div>

      <a
        href="https://wa.me/56947185397?text=Hola%20JMKT,%20vi%20sus%20casos%20de%20%C3%A9xito%20y%20quiero%20resultados%20similares%20para%20mi%20negocio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-[#070B14] hover:bg-[#131B2E] text-white font-heading font-bold text-sm transition-all duration-200 shrink-0 self-start md:self-auto"
      >
        <span>Quiero impulsar mi negocio</span>
        <span class="text-[#D4FF00]" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- 2x2 Editorial Case Study Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal">
      {cases.map((item) => (
        <article class="group rounded-3xl bg-white border border-slate-200 hover:border-slate-300 overflow-hidden shadow-[0_8px_30px_rgba(15,23,42,0.05)] hover:shadow-[0_18px_45px_rgba(15,23,42,0.1)] transition-all duration-300 flex flex-col">
          <!-- Interactive Project Preview -->
          <div class="aspect-[16/10] bg-slate-100 border-b border-slate-200 relative overflow-hidden shrink-0">
            <ProjectGallery images={item.images} title={item.title} client:visible />
          </div>

          <!-- Editorial Body -->
          <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between">
            <div>
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#4D6B00]">
                  {item.category}
                </span>
              </div>

              <h3 class="font-heading font-extrabold text-xl sm:text-2xl text-[#0F172A] leading-snug group-hover:text-[#070B14]">
                {item.title}
              </h3>

              <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
                {item.description}
              </p>

              <!-- Outcome Highlight -->
              <div class="mt-4 px-3.5 py-2.5 rounded-xl bg-[#F8FAFC] border border-slate-200/80 flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-[#658C00] shrink-0"></span>
                <span class="text-xs font-semibold text-slate-700">
                  {item.impact}
                </span>
              </div>
            </div>

            <!-- Tags & External Link -->
            <div class="mt-6 pt-5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold">
                    {tag}
                  </span>
                ))}
              </div>

              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-heading font-bold text-sm text-[#0F172A] hover:text-[#4D6B00] transition-colors shrink-0"
              >
                <span>Visitar proyecto</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
