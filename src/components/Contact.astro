---
import { Mail, Linkedin, Github, Phone, MessageSquare } from 'lucide-react';
---

<section id="contact" class="py-24 relative reveal">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    
    <div class="inline-block">
      <span
        class="inline-flex items-center gap-2 px-4 py-1.5 bg-amber-300 border-2 border-zinc-900 rounded-full text-xs font-black uppercase tracking-wider text-zinc-900 shadow-[3px_3px_0px_0px_rgba(24,24,27,1)]"
      >
        Hablemos de tu Proyecto
      </span>
    </div>

    <h2 class="text-4xl sm:text-6xl font-black tracking-tighter text-zinc-900 leading-[1.05]">
      ¿CREAMOS ALGO <span class="text-rose-600">INCREÍBLE?</span>
    </h2>

    <p class="text-lg sm:text-xl text-zinc-700 max-w-2xl mx-auto font-medium leading-relaxed">
      Ya sea que tengas una idea de negocio o necesites potenciar tu marca, estoy listo para escucharte.
    </p>

    <div class="grid sm:grid-cols-2 gap-6 max-w-2xl mx-auto pt-4">
      <!-- WhatsApp CTA Directo -->
      <a
        href="https://wa.me/56947185397?text=Hola%20Jamiro,%20vi%20tu%20web%20y%20quiero%20informaci%C3%B3n%20sobre%20tus%20servicios%20para%20mi%20negocio"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center p-8 bg-white border-2 border-zinc-900 rounded-2xl hover:bg-emerald-50 hover:border-zinc-900 shadow-[8px_8px_0px_0px_rgba(24,24,27,1)] hover:shadow-[4px_4px_0px_0px_rgba(24,24,27,1)] hover:translate-x-1 hover:translate-y-1 transition-all group duration-300"
      >
        <div class="w-14 h-14 bg-emerald-100 border-2 border-zinc-900 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform shadow-[2px_2px_0px_0px_rgba(24,24,27,1)]">
          <MessageSquare class="w-7 h-7 text-emerald-600" stroke-width={2.5} />
        </div>
        <span class="text-xl font-bold text-zinc-900 mb-1 font-heading group-hover:text-emerald-700">Hablar por WhatsApp</span>
        <span class="text-zinc-600 font-mono text-sm">+56 9 4718 5397</span>
      </a>

      <!-- Correo Electrónico -->
      <a
        href="mailto:devjamiro@gmail.com"
        class="flex flex-col items-center justify-center p-8 bg-white border-2 border-zinc-900 rounded-2xl hover:bg-rose-50 hover:border-zinc-900 shadow-[8px_8px_0px_0px_rgba(24,24,27,1)] hover:shadow-[4px_4px_0px_0px_rgba(24,24,27,1)] hover:translate-x-1 hover:translate-y-1 transition-all group duration-300"
      >
        <div class="w-14 h-14 bg-rose-100 border-2 border-zinc-900 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform shadow-[2px_2px_0px_0px_rgba(24,24,27,1)]">
          <Mail class="w-7 h-7 text-rose-600" stroke-width={2.5} />
        </div>
        <span class="text-xl font-bold text-zinc-900 mb-1 font-heading group-hover:text-rose-700">Envíame un correo</span>
        <span class="text-zinc-600 font-mono text-sm">devjamiro@gmail.com</span>
      </a>
    </div>

    <!-- Enlaces adicionales -->
    <div class="pt-6 flex flex-wrap justify-center items-center gap-8 text-zinc-700 font-semibold text-sm">
      <div class="flex items-center gap-2">
        <Phone class="w-4 h-4 text-zinc-900" />
        <span class="font-mono">+56 9 4718 5397</span>
      </div>
      <a
        href="https://linkedin.com/in/jamiro-manriquez-832aaa204"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 hover:text-rose-600 transition-colors"
      >
        <Linkedin class="w-4 h-4" />
        <span>LinkedIn</span>
      </a>
      <a
        href="https://github.com/jamirou"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 hover:text-rose-600 transition-colors"
      >
        <Github class="w-4 h-4" />
        <span>GitHub</span>
      </a>
    </div>

  </div>
</section>
