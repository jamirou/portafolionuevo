---
import JmktLogo from './JmktLogo.astro';

const WHATSAPP_URL =
  'https://wa.me/56947185397?text=Hola%20JMKT,%20quiero%20impulsar%20la%20presencia%20digital%20de%20mi%20negocio';

const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#ia', label: 'IA WhatsApp' },
  { href: '/#planes', label: 'Planes' },
  { href: '/#arma-tu-plan', label: 'Arma tu plan' },
  { href: '/#casos-exito', label: 'Casos de éxito' },
  { href: '/#certificaciones', label: 'Certificaciones' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#070B14]/90 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20">
      <!-- Logo -->
      <a
        href="/"
        aria-label="JMKT Agencia Digital - Inicio"
        class="focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4FF00] rounded-lg"
      >
        <JmktLogo size="md" />
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-7">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-300 hover:text-[#D4FF00] transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#D4FF00] hover:bg-[#CCFF00] text-[#070B14] font-heading font-bold text-sm transition-all duration-200 shadow-[0_0_20px_rgba(212,255,0,0.2)] hover:shadow-[0_0_28px_rgba(212,255,0,0.38)] hover:-translate-y-0.5"
        >
          <span>Hablemos</span>
          <span aria-hidden="true">→</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
          class="lg:hidden inline-flex items-center justify-center p-2.5 rounded-xl bg-[#131B2E] border border-slate-800 text-slate-200 hover:text-[#D4FF00] hover:border-slate-700 transition-colors cursor-pointer"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu-drawer"
    class="lg:hidden hidden border-t border-slate-800/80 bg-[#070B14]/98 backdrop-blur-xl"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link px-4 py-3 rounded-xl text-base font-medium text-slate-200 hover:text-[#D4FF00] hover:bg-[#131B2E] transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 mt-2 border-t border-slate-800">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full bg-[#D4FF00] hover:bg-[#CCFF00] text-[#070B14] font-heading font-bold text-sm transition-colors"
        >
          <span>Hablemos por WhatsApp</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && drawer && iconOpen && iconClose) {
    const closeMenu = () => {
      drawer.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
    };

    toggleBtn.addEventListener('click', () => {
      const isOpen = !drawer.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        drawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
    });

    drawer.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>
