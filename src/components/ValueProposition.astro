---
const pillars = [
  {
    number: '01',
    title: 'Posicionamiento',
    description:
      'Aparece primero en Google Maps y búsquedas de tu comuna justo cuando un cliente necesita lo que vendes.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" stroke-linejoin="round" d="m20 20-3.5-3.5"/></svg>`,
  },
  {
    number: '02',
    title: 'Experiencia Digital',
    description:
      'Sitios web ultrarrápidos, claros y adaptados a celular que transmiten seriedad y convierten visitas en mensajes.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 20h20"/></svg>`,
  },
  {
    number: '03',
    title: 'Crecimiento & IA',
    description:
      'Publicidad segmentada en Instagram/Facebook y asistentes con Inteligencia Artificial que atienden y cotizan por ti 24/7.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8"/><path stroke-linecap="round" stroke-linejoin="round" d="M17 7h4v4"/></svg>`,
  },
];
---

<section id="servicios" class="scroll-mt-20 bg-white text-[#0F172A] py-20 sm:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-start">
      <!-- Left Editorial Column -->
      <div class="lg:col-span-5 space-y-6 reveal">
        <div class="inline-flex items-center gap-3">
          <span class="w-8 h-[2px] bg-[#658C00] rounded-full"></span>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#4D6B00]">
            Crecimiento con intención
          </span>
        </div>

        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-[2.75rem] leading-[1.1] tracking-tight text-[#0F172A] text-balance">
          No se trata de estar en internet. Se trata de{' '}
          <span class="relative inline-block text-[#3F6212]">
            <span class="relative z-10">destacar.</span>
            <span
              class="absolute left-0 bottom-1 w-full h-3 bg-[#D4FF00]/80 -z-0 rounded-sm"
              aria-hidden="true"
            ></span>
          </span>
        </h2>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Hoy tus clientes deciden en segundos desde su celular. Combinamos posicionamiento en Google, diseño web de alto rendimiento y automatización con Inteligencia Artificial para que tu negocio capte oportunidades, responda al instante y venda incluso cuando no estás conectado.
        </p>

        <div class="pt-2">
          <a
            href="#planes"
            class="inline-flex items-center gap-2 font-heading font-bold text-sm text-[#0F172A] hover:text-[#4D6B00] transition-colors group"
          >
            <span>Explorar planes y soluciones</span>
            <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Right 3 Value Cards -->
      <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-3 gap-5">
        {pillars.map((item, idx) => (
          <article
            style={`--reveal-delay: ${idx * 100}ms;`}
            class="reveal group rounded-2xl bg-white border border-slate-200 hover:border-[#0F172A]/25 p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-[0_14px_35px_rgba(15,23,42,0.08)] hover:-translate-y-1"
          >
            <div>
              <div class="w-11 h-11 rounded-xl bg-[#F8FAFC] border border-slate-200 flex items-center justify-center text-[#0F172A] group-hover:bg-[#070B14] group-hover:text-[#D4FF00] group-hover:border-[#070B14] transition-colors duration-300 mb-6">
                <span set:html={item.icon} />
              </div>

              <div class="flex items-center gap-2 mb-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-[#D4FF00] text-[#070B14] font-heading font-extrabold text-xs tracking-wide">
                  {item.number}
                </span>
                <span class="text-slate-300 font-bold" aria-hidden="true">·</span>
                <h3 class="font-heading font-bold text-base text-[#0F172A]">
                  {item.title}
                </h3>
              </div>

              <p class="text-sm text-slate-600 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center text-xs font-semibold text-slate-400 group-hover:text-[#0F172A] transition-colors">
              <span>Enfocado en resultados</span>
              <span class="ml-auto transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
