---
import "../styles/global.css";
import favicon from "../assets/favicon.png";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href={favicon.src} />
    
    <!-- SEO & Meta Tags -->
    <title>Jamiro Manríquez | Morales EIRL</title>
    <meta name="description" content="Contacto comercial de Jamiro Manríquez, Ejecutivo Comercial en Morales EIRL." />
    <meta name="robots" content="noindex, nofollow" />
    
    <!-- Open Graph / Card Info -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jamiro Manríquez - Contacto" />
    <meta property="og:description" content="Añádeme a tus contactos o envíame un mensaje directo." />
    <meta property="og:image" content="/moralesreducido.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#09090b] text-zinc-100 antialiased selection:bg-yellow-400/30 h-dvh flex flex-col items-center justify-center font-sans overflow-hidden p-4">
    
    <!-- Subtle Background Gradient -->
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_50%_50%,rgba(250,204,21,0.03)_0%,rgba(9,9,11,1)_100%)]"></div>

    <!-- Content Container -->
    <div class="w-full max-w-sm flex flex-col items-center">
      
      <!-- Profile Section -->
      <header class="text-center mb-8">
        <div class="w-20 h-20 bg-zinc-900 border border-zinc-800 rounded-3xl flex items-center justify-center mb-4 mx-auto shadow-xl">
          <span class="text-2xl font-bold text-yellow-400 font-heading">JM</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white font-heading">
          Jamiro Manríquez
        </h1>
        <p class="text-[10px] font-semibold tracking-[0.2em] uppercase text-zinc-500 mt-2">
          Ejecutivo Comercial • Morales EIRL
        </p>
      </header>

      <!-- Links Stack -->
      <nav class="w-full space-y-3">
        
        <!-- Phone Link -->
        <a 
          href="tel:+56947185397"
          class="flex items-center gap-3 p-4 rounded-2xl bg-zinc-900/50 hover:bg-zinc-800/80 border border-zinc-800/50 hover:border-yellow-400/30 transition-all duration-300 group"
        >
          <div class="w-10 h-10 rounded-xl bg-zinc-950 flex items-center justify-center border border-zinc-800 text-zinc-400 group-hover:text-yellow-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="flex-grow">
            <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">Llamar</p>
            <p class="text-sm font-medium text-zinc-200">+56 9 4718 5397</p>
          </div>
        </a>

        <!-- Email Link -->
        <a 
          href="mailto:jamiro.manriquez@morales-eirl.com"
          class="flex items-center gap-3 p-4 rounded-2xl bg-zinc-900/50 hover:bg-zinc-800/80 border border-zinc-800/50 hover:border-yellow-400/30 transition-all duration-300 group"
        >
          <div class="w-10 h-10 rounded-xl bg-zinc-950 flex items-center justify-center border border-zinc-800 text-zinc-400 group-hover:text-yellow-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div class="flex-grow">
            <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">Email</p>
            <p class="text-sm font-medium text-zinc-200">jamiro.manriquez@morales-eirl.com</p>
          </div>
        </a>

        <!-- Website Link -->
        <a 
          href="https://morales-eirl.com/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-4 rounded-2xl bg-zinc-900/50 hover:bg-zinc-800/80 border border-zinc-800/50 hover:border-yellow-400/30 transition-all duration-300 group"
        >
          <div class="w-10 h-10 rounded-xl bg-zinc-950 flex items-center justify-center border border-zinc-800 text-zinc-400 group-hover:text-yellow-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <div class="flex-grow">
            <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">Web</p>
            <p class="text-sm font-medium text-zinc-200">morales-eirl.com</p>
          </div>
        </a>

        <!-- Download vCard CTA -->
        <button 
          id="download-vcard"
          class="w-full mt-4 bg-yellow-400 hover:bg-yellow-300 text-zinc-950 font-bold py-4 px-6 rounded-2xl transition-all duration-300 flex items-center justify-center gap-2 active:scale-[0.98] shadow-lg shadow-yellow-400/10 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
          <span class="text-sm">Guardar Contacto</span>
        </button>

      </nav>

      <!-- Footer -->
      <footer class="mt-12 text-center">
        <p class="text-[9px] uppercase tracking-widest text-zinc-600 font-medium">&copy; {new Date().getFullYear()} Morales EIRL</p>
      </footer>

    </div>

    <!-- vCard Script -->
    <script>
      const downloadBtn = document.getElementById('download-vcard');
      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          const vcardData = [
            'BEGIN:VCARD',
            'VERSION:3.0',
            'FN:Jamiro Manríquez',
            'N:Manríquez;Jamiro;;;',
            'ORG:Morales EIRL',
            'TITLE:Ejecutivo Comercial',
            'TEL;TYPE=CELL,VOICE:+56947185397',
            'EMAIL;TYPE=INTERNET,WORK:jamiro.manriquez@morales-eirl.com',
            'URL:https://morales-eirl.com/',
            'END:VCARD'
          ].join('\r\n');

          const blob = new Blob([vcardData], { type: 'text/vcard;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'Jamiro_Manriquez.vcf';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }
    </script>
  </body>
</html>
