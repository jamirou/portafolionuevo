---
import "../styles/global.css";
import favicon from "../assets/favicon.png";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href={favicon.src} />
    
    <!-- SEO & Meta Tags -->
    <title>Jamiro Manríquez - Contacto | Morales EIRL</title>
    <meta name="description" content="Contacto comercial de Jamiro Manríquez, Ejecutivo Comercial en Morales EIRL. Guarda mis datos de contacto directamente en tu teléfono." />
    <meta name="robots" content="noindex, nofollow" />
    
    <!-- Open Graph / Card Info -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jamiro Manríquez - Contacto | Morales EIRL" />
    <meta property="og:description" content="Contacto comercial. Añádeme a tus contactos o envíame un mensaje directo." />
    <meta property="og:image" content="/moralesreducido.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@500;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0B0B0C] text-zinc-100 antialiased selection:bg-yellow-400 selection:text-zinc-950 flex flex-col justify-center min-h-screen font-sans">
    
    <!-- Background glow elements -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-yellow-400/5 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[-10%] left-10 w-[300px] h-[300px] bg-zinc-900/40 rounded-full blur-[80px]"></div>
    </div>

    <!-- Main Container -->
    <main class="w-full max-w-[420px] mx-auto px-4 py-8 flex flex-col justify-center">
      
      <div class="bg-zinc-900/50 backdrop-blur-xl border border-zinc-800/80 rounded-[2rem] overflow-hidden shadow-2xl flex flex-col">
        
        <!-- Header Banner (Visual Gradient) -->
        <div class="bg-gradient-to-b from-zinc-950 via-zinc-900 to-transparent pt-12 pb-8 px-6 text-center relative border-b border-zinc-800/30">
          
          <!-- Name and Title (Logo removed, Name is first) -->
          <h1 class="text-3xl font-bold tracking-tight text-white font-heading">
            Jamiro Manríquez
          </h1>
          <p class="text-xs font-semibold tracking-widest uppercase text-yellow-400/90 font-sans mt-2.5 flex items-center justify-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            Ejecutivo Comercial
          </p>
          <p class="text-zinc-500 text-xs mt-1">Morales EIRL</p>
        </div>

        <!-- Float Buttons Row (LEXO Style overlap position) -->
        <div class="flex justify-center gap-6 -mt-6 z-10">
          <a 
            href="tel:+56947185397" 
            class="w-12 h-12 rounded-full bg-zinc-950 border border-zinc-800 hover:border-yellow-400/80 text-zinc-100 hover:text-yellow-400 transition-all duration-300 flex items-center justify-center hover:scale-105 active:scale-95 shadow-md shadow-black/40"
            title="Llamar por teléfono"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <a 
            href="mailto:jamiro.manriquez@morales-eirl.com" 
            class="w-12 h-12 rounded-full bg-zinc-950 border border-zinc-800 hover:border-yellow-400/80 text-zinc-100 hover:text-yellow-400 transition-all duration-300 flex items-center justify-center hover:scale-105 active:scale-95 shadow-md shadow-black/40"
            title="Enviar correo"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
        </div>

        <!-- Contact Detail Cards -->
        <div class="px-6 pt-10 pb-8 space-y-4">
          
          <!-- Phone Item -->
          <a 
            href="tel:+56947185397"
            class="group flex items-center gap-4 p-4 rounded-2xl bg-zinc-950/40 hover:bg-zinc-900/60 border border-zinc-800/40 hover:border-zinc-800 transition-all duration-300"
          >
            <div class="w-10 h-10 rounded-xl bg-zinc-900 flex items-center justify-center border border-zinc-800 text-zinc-400 group-hover:text-yellow-400 group-hover:border-yellow-400/20 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="flex-grow min-w-0">
              <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Teléfono</p>
              <p class="text-sm font-medium text-zinc-200 group-hover:text-white transition-colors truncate">+56 9 4718 5397</p>
            </div>
            <div class="text-zinc-600 group-hover:text-yellow-400 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>

          <!-- Email Item -->
          <a 
            href="mailto:jamiro.manriquez@morales-eirl.com"
            class="group flex items-center gap-4 p-4 rounded-2xl bg-zinc-950/40 hover:bg-zinc-900/60 border border-zinc-800/40 hover:border-zinc-800 transition-all duration-300"
          >
            <div class="w-10 h-10 rounded-xl bg-zinc-900 flex items-center justify-center border border-zinc-800 text-zinc-400 group-hover:text-yellow-400 group-hover:border-yellow-400/20 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div class="flex-grow min-w-0">
              <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Correo Electrónico</p>
              <p class="text-sm font-medium text-zinc-200 group-hover:text-white transition-colors truncate">jamiro.manriquez@morales-eirl.com</p>
            </div>
            <div class="text-zinc-600 group-hover:text-yellow-400 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>

          <!-- Website Item -->
          <a 
            href="https://morales-eirl.com/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group flex items-center gap-4 p-4 rounded-2xl bg-zinc-950/40 hover:bg-zinc-900/60 border border-zinc-800/40 hover:border-zinc-800 transition-all duration-300"
          >
            <div class="w-10 h-10 rounded-xl bg-zinc-900 flex items-center justify-center border border-zinc-800 text-zinc-400 group-hover:text-yellow-400 group-hover:border-yellow-400/20 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <div class="flex-grow min-w-0">
              <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Sitio Web</p>
              <p class="text-sm font-medium text-zinc-200 group-hover:text-white transition-colors truncate">morales-eirl.com</p>
            </div>
            <div class="text-zinc-600 group-hover:text-yellow-400 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </div>
          </a>

          <!-- Download Contact CTA -->
          <button 
            id="download-vcard"
            class="w-full mt-6 bg-gradient-to-r from-yellow-400 via-yellow-300 to-yellow-500 hover:from-yellow-300 hover:to-yellow-400 text-zinc-950 font-bold py-4 px-6 rounded-2xl shadow-[0_8px_30px_rgb(234,255,18,0.15)] hover:shadow-[0_8px_30px_rgb(234,255,18,0.3)] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-3 font-heading cursor-pointer border border-yellow-200/20 group"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-y-0.5 transition-transform"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
            <span>Añadir a contactos</span>
          </button>

        </div>
      </div>
    </main>

    <!-- Interactive vCard Generator Script -->
    <script>
      const downloadBtn = document.getElementById('download-vcard');

      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          // Dynamic vCard construction (vCard format 3.0)
          const vcardData = [
            'BEGIN:VCARD',
            'VERSION:3.0',
            'FN:Jamiro Manríquez',
            'N:Manríquez;Jamiro;;;',
            'ORG:Morales EIRL',
            'TITLE:Ejecutivo Comercial',
            'TEL;TYPE=CELL,VOICE;VALUE=uri:tel:+56947185397',
            'EMAIL;TYPE=INTERNET,WORK,PREF:jamiro.manriquez@morales-eirl.com',
            'URL;TYPE=WORK:https://morales-eirl.com/',
            'REV:' + new Date().toISOString(),
            'END:VCARD'
          ].join('\r\n');

          try {
            // Generate Blob and trigger download
            const blob = new Blob([vcardData], { type: 'text/vcard;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'Jamiro_Manriquez_Morales.vcf';
            
            // Append and click
            document.body.appendChild(a);
            a.click();
            
            // Cleanup
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          } catch (error) {
            console.error('Error al generar la vCard:', error);
            // Fallback for older browsers
            window.open('data:text/vcard;charset=utf-8,' + encodeURIComponent(vcardData));
          }
        });
      }
    </script>
  </body>
</html>
